# Токен вашего Telegram-бота (от @BotFather)
BOT_TOKEN=ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER

# Адрес вашего сайта плеера (уже прописан по умолчанию)
WEBAPP_URL=https://awuro.sergeyhownan.workers.dev

# Публичный HTTPS-адрес сервера, на котором запущен этот бот (для автоподключения сайта https://awuro.sergeyhownan.workers.dev/)
# Например: https://bot-1234.your-host.ru  (или задайте прямо в Telegram командой /setapi https://...)
BOT_API_URL=

# (Необязательно) ID приватного канала-хранилища (или напишите /setstorage в канале)
STORAGE_CHAT_ID=

# (Необязательно) 1 = автосохранять прослушанные с сайта треки в канал; 0 = не грузить сервер (по умолчанию 0)
AUTO_CACHE_TO_TG=0

# (Необязательно) Ваш Telegram user ID
ADMIN_ID=

HOST=0.0.0.0
PORT=8080
