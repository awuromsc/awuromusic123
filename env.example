# Токен вашего Telegram-бота (получить у @BotFather)
BOT_TOKEN=ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER

# HTTPS-ссылка на ваш запущенный сайт APATHY (для кнопки «Открыть плеер» прямо внутри Telegram)
# Например: https://apathy-music.example.com  или  https://your-site.pages.dev/?api=https://your-bot-host.com
WEBAPP_URL=

# (Необязательно) ID приватного Telegram-канала для авто-кэширования всех треков (например: -1001234567890)
# Можно оставить пустым и просто написать команду /setstorage в вашем канале или чате с ботом!
STORAGE_CHAT_ID=

# (Необязательно) Ваш Telegram user ID (чтобы только вы могли менять чат-хранилище)
ADMIN_ID=

# Порт веб-сервера (большинство Python-хостингов подставляют PORT автоматически)
HOST=0.0.0.0
PORT=8080
